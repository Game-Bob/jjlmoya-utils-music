---
import { SEORenderer } from '@jjlmoya/utils-shared';
import { guitarStringTensionCalculator } from './entry';
import type { KnownLocale } from '../../types';

interface Props {
  locale?: KnownLocale;
}

const { locale = 'es' } = Astro.props;
const loader = guitarStringTensionCalculator.i18n[locale as KnownLocale] ?? guitarStringTensionCalculator.i18n.es ?? guitarStringTensionCalculator.i18n.en;
const content = loader ? await loader() : null;
---

{content?.seo && content.seo.length > 0 && <SEORenderer content={{ locale, sections: content.seo }} />}
